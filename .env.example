# Copy to .env and fill in. Required fields use :? in compose.
# Prefer a password without $ or other Compose-special characters.
# Demo default below is for local/portfolio only — change for anything shared.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=candlecore

# Host port defaults if omitted: 5432 / 5059 / 5173
POSTGRES_HOST_PORT=5432
API_HOST_PORT=5059
CLIENT_HOST_PORT=5173

ASPNETCORE_ENVIRONMENT=Production
